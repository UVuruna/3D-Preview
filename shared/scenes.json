        },
        {
          "channel": "part.opacity", "path": "shell/face:-y",
          "keys": [
            { "t": 0, "value": 1, "ease": "ease-in-out" },
            { "t": 0.3, "value": 0.12 },
            { "t": 0.7, "value": 0.12, "ease": "ease-in-out" },
