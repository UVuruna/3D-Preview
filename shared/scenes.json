    {
      "_comment": "Scene 1 (PLAN.md, Cinematic Scenes) — Offices variant. The camera flies to the +x+y+z body diagonal; the shell thins to glass and the projection blends to orthographic; at alignment the two triangles of the Hexagram draw themselves (part.strokeProgress) in their Court/Genesis dress (the hexagram builder's own default colours — never restated here).",
      "name": "hexagram_offices",
      "label": "Hexagram X-ray — Offices",
      "duration": 9,
      "loop": false,
      "content": {
        "type": "group", "name": "scene",
        "children": [
          { "type": "cube", "name": "shell", "colors": "poles" },
          { "type": "hexagram", "name": "hexagram", "diagonal": "+x+y+z" },
          { "type": "marker", "name": "seat:+x+y+z", "position": [0.5, 0.5, 0.5], "radius": 0.055, "color": "#F5E6B8" },
          { "type": "marker", "name": "seat:centre", "position": [0, 0, 0], "radius": 0.065, "color": "#F5E6B8" },
          { "type": "marker", "name": "seat:-x-y-z", "position": [-0.5, -0.5, -0.5], "radius": 0.055, "color": "#F5E6B8" }
        ]
      },
      "tracks": [
        { "channel": "camera.azimuth", "keys": [{ "t": 0, "value": 20, "ease": "ease-in-out" }, { "t": 0.55, "value": 45 }] },
        { "channel": "camera.elevation", "keys": [{ "t": 0, "value": 20, "ease": "ease-in-out" }, { "t": 0.55, "value": 35.264 }] },
        { "channel": "camera.projection", "keys": [{ "t": 0, "value": "perspective" }, { "t": 0.55, "value": "orthographic" }] },
        { "channel": "camera.dolly", "keys": [{ "t": 0, "value": 1, "ease": "ease-in-out" }, { "t": 1, "value": 1.15 }] },
        {
          "channel": "part.opacity", "path": "scene/shell/face:+x",
          "keys": [{ "t": 0, "value": 1, "ease": "ease-in-out" }, { "t": 0.55, "value": 0.15 }]
        },
        {
          "channel": "part.opacity", "path": "scene/shell/face:-x",
          "keys": [{ "t": 0, "value": 1, "ease": "ease-in-out" }, { "t": 0.55, "value": 0.15 }]
        },
        {
          "channel": "part.opacity", "path": "scene/shell/face:+y",
          "keys": [{ "t": 0, "value": 1, "ease": "ease-in-out" }, { "t": 0.55, "value": 0.15 }]
        },
        {
          "channel": "part.opacity", "path": "scene/shell/face:-y",
          "keys": [{ "t": 0, "value": 1, "ease": "ease-in-out" }, { "t": 0.55, "value": 0.15 }]
        },
        {
          "channel": "part.opacity", "path": "scene/shell/face:+z",
          "keys": [{ "t": 0, "value": 1, "ease": "ease-in-out" }, { "t": 0.55, "value": 0.15 }]
        },
        {
          "channel": "part.opacity", "path": "scene/shell/face:-z",
          "keys": [{ "t": 0, "value": 1, "ease": "ease-in-out" }, { "t": 0.55, "value": 0.15 }]
        },
        {
          "_comment": "The six polar-corner edges 'light as the spokes' — the SAME wireframe every cube already carries, simply raised from its usual faint 0.35 (shared/spec.json neutral.edgeOpacity) as the hexagon resolves.",
          "channel": "part.opacity", "path": "scene/shell/edges",
          "keys": [{ "t": 0, "value": 0.35, "ease": "ease-in-out" }, { "t": 0.55, "value": 0.9 }]
        },
        {
          "channel": "part.opacity", "path": "scene/seat:+x+y+z",
          "keys": [{ "t": 0, "value": 0, "ease": "ease-in-out" }, { "t": 0.55, "value": 1 }]
        },
        {
          "channel": "part.opacity", "path": "scene/seat:centre",
          "keys": [{ "t": 0, "value": 0, "ease": "ease-in-out" }, { "t": 0.55, "value": 1 }]
        },
        {
          "channel": "part.opacity", "path": "scene/seat:-x-y-z",
          "keys": [{ "t": 0, "value": 0, "ease": "ease-in-out" }, { "t": 0.55, "value": 1 }]
        },
        {
          "channel": "part.strokeProgress", "path": "scene/hexagram/triangle:up",
          "keys": [{ "t": 0.55, "value": 0, "ease": "ease-in-out" }, { "t": 0.85, "value": 1 }]
        },
        {
          "channel": "part.strokeProgress", "path": "scene/hexagram/triangle:down",
          "keys": [{ "t": 0.55, "value": 0, "ease": "ease-in-out" }, { "t": 0.85, "value": 1 }]
        }
      ]
    },

